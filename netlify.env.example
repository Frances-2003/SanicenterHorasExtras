# Set through Netlify environment settings, context PRODUCTION only.
# Select Functions-only scope if the plan supports scopes. Free may expose values
# to the build process too: NEVER prefix a server secret with VITE_.
# Do not copy secrets into this file, netlify.toml, or a VITE_* variable.
WORKFLOW_PRODUCTION_ENABLED=false
GOOGLE_CLOUD_PROJECT=sanicenterdb
APP_ORIGIN=https://YOUR-SITE.netlify.app
WORKFLOW_WRITE_MODE=disabled
NODE_OPTIONS=--experimental-require-module
WORKFLOW_ALLOWED_ACTOR_UIDS=
WORKFLOW_ALLOWED_WORKER_UIDS=
# FIREBASE_SERVICE_ACCOUNT_JSON: provider secret containing a dedicated least-privilege identity.
# Never use the personal Firebase CLI audit session as this credential.
