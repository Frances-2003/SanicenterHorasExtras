rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function active() { return request.auth != null && profile().active == true && profile().role in ['trabajador', 'jefe', 'admin']; }
    function managerFor(data) { return profile().role == 'admin' || (profile().role == 'jefe' && ((profile().area != '' && data.area == profile().area) || data.area in profile().get('authorizedAreas', []))); }
    function ownOrManager(data) { return active() && (data.workerId == request.auth.uid || managerFor(data)); }
    match /users/{uid} {
      // Self-read permits the existing login to explain inactive accounts.
      allow get: if request.auth != null && (uid == request.auth.uid || (active() && managerFor(resource.data)));
      allow list: if active() && managerFor(resource.data);
      allow write: if false;
    }
    match /overtime/{id} { allow read: if ownOrManager(resource.data); allow write: if false; }
    match /compensations/{id} { allow read: if ownOrManager(resource.data); allow write: if false; }
    // Only a minimal public schedule is shared; no reasons, allocations or balances.
    match /calendar/{id} { allow read: if active() && resource.data.active == true; allow write: if false; }
    match /audit/{id} { allow read: if active() && managerFor(resource.data); allow write: if false; }
    match /counters/{id} { allow read, write: if false; }
    match /workflowLocks/{id} { allow read, write: if false; }
    match /workflowLimits/{id} { allow read, write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
