# Public build configuration. These values are embedded in the browser bundle.
# Set in Netlify Production context (or a private local .env.production.local).
VITE_REAL_FIREBASE_ENABLED=true
VITE_REAL_FINANCIAL_WRITES_ENABLED=false
VITE_FIREBASE_PROJECT_ID=sanicenterdb
VITE_FIREBASE_AUTH_DOMAIN=sanicenterdb.firebaseapp.com
VITE_FIREBASE_API_KEY=YOUR_EXISTING_PUBLIC_WEB_API_KEY
VITE_FIREBASE_APP_ID=YOUR_EXISTING_PUBLIC_WEB_APP_ID
VITE_WORKFLOW_API_URL=
# After explicit authorization only, change the financial flag to true and rebuild.
